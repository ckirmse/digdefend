{
  "name": "DigDefendGameplay",
  "servePlaceIds": [
    72646464251078
  ],
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "loading": {
        "$path": "src/first/loading.client.luau"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": {
          "optional": "Packages"
        }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server",
        "Libs": {
          "$path": "ServerLibs"
        }
      },
      "GameData": {
        "$path": "src/server/GameData"
      },
      "Gameplay": {
        "$path": "src/gameplay/server"
      },
      "Tests": {
        "$className": "Folder",
        "TestRunner": {
          "$path": "src/tests/TestRunner.luau"
        },
        "Shared": {
          "$path": "src/tests/shared"
        },
        "DevPackages": {
          "$path": "DevPackages"
        }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "Gameplay": {
          "$path": "src/gameplay/client"
        }
      }
    }
  }
}
